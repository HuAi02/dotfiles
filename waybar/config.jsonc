{
    "name": "float",
    "layer": "top",
    "position": "right",
    "mode": "dock",
    "width": 67,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "on-sigusr1": "toggle",
    "on-sigusr2": "reload",
    "margin-top": 0,
    "margin-right": 0,
    "margin-left": 0,
    "margin-bottom": 0,
    "modules-left": ["clock#date", "clock#time", "idle_inhibitor", "tray"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["pulseaudio#speaker", "pulseaudio#microphone", "backlight", "battery", "memory", "cpu"],

    "hyprland/window": {
        "max-length": 100,
        "format": "{title}"
    },

    "battery": {
        "format": "  {icon}\n{capacity:02d}%",
        "format-icons": {
            "default": ["", "", "", ""],
            "plugged": ""
        },
        "interval": 5,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "tooltip": true,
        "tooltip-format": "Battery: {capacity}%",
        "on-click": "gnome-power-statistics"
    },

    "clock#date": {
        "format": "{:%d\n%m}",
        "tooltip-format": "{:%A, %B %d %Y}",
        "interval": 30,
        "on-click": "gnome-calendar"
    },

    "clock#time": {
        "format": "{:%H\n%M}",
        "tooltip": false,
        "on-click": "gnome-clocks",
        "interval": 1
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "start-activated": true,
        "tooltip": true,
        "tooltip-format": "Idle inhibition: {status}"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 12
    },

    "cpu": {
        "format": "  󰍛\n{usage:02d}%",
        "interval": 1,
        "min-length": 6,
        "tooltip": true,
        "tooltip-format": "CPU: {usage:02d}%\nLoad: {load:.1f}",
        "on-click": "kitty btop"
    },

    "memory": {
        "interval": 10,
        "format": "  󰾆\n{percentage:02d}%",
        "tooltip": true,
        "tooltip-format": "RAM: {percentage:02d}%\n{used:0.1f}GiB / {total:0.1f}GiB",
        "on-click": "kitty btop"
    },

    "pulseaudio#speaker": {
        "scroll-step": 1,
        "format": "  󰕾\n{volume:02d}%",
        "format-muted": "󰖁 Muted",
        "format-bluetooth": " {volume:02d}%",
        "on-click": "pamixer --toggle-mute",
        "on-click-right": "pavucontrol -t 3",
        "on-scroll-up": "pamixer --increase 1",
        "on-scroll-down": "pamixer --decrease 1",
        "tooltip-format": "Speaker | {volume}%\n{desc}"
    },

    "pulseaudio#microphone": {
        "format": "  \n{source_volume:02d}%",
        "format-source": "  \n{source_volume:02d}%",
        "format-source-muted": " Muted",
        "on-click": "pamixer --default-source --toggle-mute",
        "on-click-right": "pavucontrol -t 4",
        "on-scroll-up": "pamixer --default-source --increase 1",
        "on-scroll-down": "pamixer --default-source --decrease 1",
        "tooltip-format": "Microphone | {source_volume}%",
        "scroll-step": 1
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "  {icon}\n{percent:02d}%",
        "tooltip-format": "Brightness: {percent}%",
        "tooltip": true,
        "format-icons": ["", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "smooth-scrolling-threshold": 1
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "壹",
            "2": "貳",
            "3": "叁",
            "4": "肆",
            "5": "伍",
            "6": "陸",
            "7": "柒",
            "8": "捌",
            "9": "玖",
            "10": "拾",
            "default": "囧"
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    }
}
